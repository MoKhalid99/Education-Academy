@code {
    private string userId = string.Empty;
    private string userName = string.Empty;
    private string userInitial = string.Empty; 
    private ElementReference messagesContainer; 

    private List<ChatSession> sessions = new();
    private List<ChatMessage> messages = new();
    private int currentSessionId = 0;
    
    private string userInput = string.Empty; 
    
    private bool isGenerating = false;
    private bool sidebarOpen = true;
    private string errorMessage = string.Empty;

    [CascadingParameter(Name = "IsDarkMode")] public bool IsDarkMode { get; set; }

    // خاصية محلية للقراءة
    private bool isDarkMode => IsDarkMode;

    protected override async Task OnInitializedAsync()
    {
        _ = Configuration["AISettings:PageUrl"] ?? "/AI";

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            userName = user.FindFirst("FullName")?.Value ?? user.Identity.Name ?? "مستخدم الأكاديمية";
            
            // استخراج الحرف الأول من الاسم وعرضه كحرف كبير داخل الأفاتار
            if (!string.IsNullOrWhiteSpace(userName))
            {
                userInitial = userName.Trim().Substring(0, 1).ToUpper();
            }
            
            await LoadSessionsFromDatabase();
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private async Task LoadSessionsFromDatabase()
    {
        try
        {
            errorMessage = string.Empty;
            sessions = await DbContext.ChatSessions
                .Where(s => s.UserID == userId)
                .OrderByDescending(s => s.CreatedAt)
                .ToListAsync();
        }
        catch (Exception)
        {
            errorMessage = "حدث خطأ أثناء تحميل المحادثات السابقة.";
        }
    }

    // إرسال رسالة من شاشة الترحيب — تنشئ محادثة جديدة أولاً ثم ترسل
    private async Task SendMessageFromWelcome()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isGenerating) return;
        await CreateNewSession();
        await SendMessage();
    }

    private async Task CreateNewSession()
    {
        try
        {
            errorMessage = string.Empty;
            string defaultTitle = $"محادثة جديدة {DateTime.Now:yyyy-MM-dd HH:mm}";
            
            var session = await ChatbotService.CreateSessionAsync(userId, defaultTitle);
            sessions.Insert(0, session);
            
            await SelectSession(session.SessionID);
        }
        catch (Exception)
        {
            errorMessage = "فشل إنشاء محادثة جديدة.";
        }
    }

    private async Task SelectSession(int sessionId)
    {
        try
        {
            errorMessage = string.Empty;
            currentSessionId = sessionId;
            
            var history = await ChatbotService.GetHistoryAsync(userId, sessionId);
            if (history != null)
            {
                messages = history.ToList();
            }
            else
            {
                messages = new List<ChatMessage>();
            }
            
            await ScrollToBottom();
        }
        catch (Exception)
        {
            errorMessage = "فشل تحميل رسائل المحادثة.";
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isGenerating) return;

        if (currentSessionId == 0)
        {
            await CreateNewSession();
        }

        var userMsgText = userInput;
        userInput = string.Empty; // تفريغ صندوق الإدخال فوراً
        isGenerating = true;

        var userMsg = new ChatMessage 
        { 
            SessionID = currentSessionId,
            Role = AiRoles.User, 
            Content = userMsgText, 
            CreatedAt = DateTime.UtcNow 
        };
        messages.Add(userMsg);
        await ScrollToBottom();

        try
        {
            var request = new ChatRequest { SessionId = currentSessionId, Message = userMsgText };
            var response = await ChatbotService.SendMessageAsync(userId, request);

            if (response != null && string.IsNullOrEmpty(response.Error))
            {
                messages.Add(new ChatMessage 
                { 
                    SessionID = currentSessionId,
                    Role = AiRoles.Assistant, 
                    Content = response.Reply, 
                    CreatedAt = response.CreatedAt 
                });
            }
            else
            {
                errorMessage = response?.Error ?? "لم نتمكن من تلقي إجابة من الذكاء الاصطناعي.";
            }
        }
        catch (Exception)
        {
            errorMessage = "حدثت مشكلة في الخادم أثناء معالجة الرد.";
        }
        finally
        {
            isGenerating = false;
            await ScrollToBottom();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "setTimeout(() => { const el = document.querySelector('.edo-messages-container'); if(el) el.scrollTop = el.scrollHeight; }, 50);");
        }
        catch { }
    }
}