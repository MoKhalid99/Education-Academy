@page "/AI"
@using ChatbotModule.Models
@using ChatbotModule.Services
@using ChatbotModule.AI
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using EducationAcademy.Data
@inject IChatbotService ChatbotService
@inject AcademyDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<div class="edo-page @(isDarkMode ? "dark-theme" : "light-theme")">

    @* لشريط الجانبي *@
    <aside class="edo-sidebar @(sidebarOpen ? "" : "collapsed")">

        <div class="edo-sidebar-top">
            <div class="edo-logo">
                <div class="edo-logo-mark">
                    <svg viewBox="0 0 40 40" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
                        <path class="edo-logo-diamond" d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2" opacity="0.97"/>
                        <rect x="9" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.1"/>
                        <rect x="22" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.1"/>
                        <line x1="18" y1="20" x2="22" y2="20" class="edo-logo-glasses" stroke-width="1.3"/>
                        <line x1="7"  y1="20" x2="9"  y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                        <line x1="31" y1="20" x2="33" y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                    </svg>
                </div>
                <span class="edo-logo-text">EDo </span>
            </div>
            <button class="edo-sidebar-toggle" @onclick="ToggleSidebar" title="إغلاق/فتح القائمة">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" fill="currentColor"/></svg>
            </button>
        </div>

        <button class="edo-new-chat-btn" @onclick="CreateNewSession" disabled="@isGenerating">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/></svg>
            <span>محادثة جديدة</span>
        </button>

        <div class="edo-history-list">
            <div class="edo-history-group">
                <div class="edo-history-label">المحادثات الأخيرة</div>
                @if (sessions == null)
                {
                    <div class="edo-history-item loading">جاري التحميل...</div>
                }
                else if (!sessions.Any())
                {
                    <div class="edo-history-item empty">لا توجد محادثات سابقة</div>
                }
                else
                {
                    @foreach (var session in sessions)
                    {
                        <div class="edo-history-item @(session.SessionID == currentSessionId ? "active" : "")" 
                             @onclick="() => SelectSession(session.SessionID)">
                            <svg viewBox="0 0 24 24" width="14" height="14"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z" fill="currentColor"/></svg>
                            <span class="edo-history-title">@(string.IsNullOrWhiteSpace(session.Title) ? "محادثة غير معنونة" : session.Title)</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="edo-sidebar-footer">
            <div class="edo-user-profile">
                <div class="edo-avatar">@userInitial</div>
                <div class="edo-user-info">
                    <div class="edo-user-name">@userName</div>
                    <div class="edo-user-status">متصل حالياً</div>
                </div>
            </div>
        </div>
    </aside>

    @*منطقة المحتوى الأساسية *@
    <main class="edo-main-content">
        @if (currentSessionId == 0)
        {
            @* شاشة الترحيب *@
            <div class="edo-welcome-container">
                <div class="edo-welcome-icon">
                    <svg viewBox="0 0 40 40" width="72" height="72" xmlns="http://www.w3.org/2000/svg">
                        <path class="edo-logo-diamond" d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2"/>
                        <rect x="9" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.1"/>
                        <rect x="22" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.1"/>
                        <line x1="18" y1="20" x2="22" y2="20" class="edo-logo-glasses" stroke-width="1.3"/>
                        <line x1="7"  y1="20" x2="9"  y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                        <line x1="31" y1="20" x2="33" y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                    </svg>
                </div>
                <h1>مرحباً، <span class="edo-welcome-name">@userName</span> </h1>
                <p class="edo-welcome-sub">كيف يمكنني مساعدتك اليوم؟</p>

                @* مكان الكتابة *@
                <div class="edo-welcome-input-wrap">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="edo-error-message">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/></svg>
                            <span>@errorMessage</span>
                        </div>
                    }
                    <div class="edo-input-area-container">
                        <div class="edo-input-box-row">
                            <textarea class="edo-textarea"
                                      placeholder="اسألني عن أي شيء برمجياً..."
                                      @bind="userInput"
                                      @bind:event="oninput"
                                      @onkeydown="HandleKeyDown"
                                      disabled="@isGenerating"
                                      rows="1"></textarea>
                            <button class="edo-send-btn" @onclick="SendMessageFromWelcome" disabled="@(isGenerating || string.IsNullOrWhiteSpace(userInput))">
                                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"/></svg>
                            </button>
                        </div>
                        <div class="edo-input-footer">
                            <div class="edo-attach-btns"></div>
                            <div class="edo-hint"> شات بوت مخصص للاسئلة البرمجية و المشاكل التقنية</div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* واجهة المحادثة المستمرة *@
            <header class="edo-chat-header">
                <div class="edo-header-title">
                    <h2>@(sessions?.FirstOrDefault(s => s.SessionID == currentSessionId)?.Title ?? "محادثة نشطة")</h2>
                </div>
            </header>

            <div class="edo-messages-container" @ref="messagesContainer">
                @if (messages != null)
                {
                    @foreach (var message in messages)
                    {
                        <div class="edo-message-wrapper @(message.Role == "user" ? "user-style" : "bot-style")">
                            <div class="edo-message-avatar">
                                @if (message.Role == "user")
                                {
                                    @userInitial
                                }
                                else
                                {
                                    <svg viewBox="0 0 40 40" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                                        <path class="edo-logo-diamond" d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2"/>
                                        <rect x="9" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.2"/>
                                        <rect x="22" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.2"/>
                                        <line x1="18" y1="20" x2="22" y2="20" class="edo-logo-glasses" stroke-width="1.3"/>
                                        <line x1="7"  y1="20" x2="9"  y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                                        <line x1="31" y1="20" x2="33" y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                                    </svg>
                                }
                            </div>
                            <div class="edo-message-bubble">
                                <div class="edo-message-sender">@(message.Role == "user" ? userName : "EDo")</div>
                                <div class="edo-message-text">@message.Content</div>
                                <div class="edo-message-time">@message.CreatedAt.ToLocalTime().ToString("t")</div>
                            </div>
                        </div>
                    }

                    @if (isGenerating)
                    {
                        <div class="edo-message-wrapper bot-style">
                            <div class="edo-message-avatar">
                                <svg viewBox="0 0 40 40" width="20" height="20" xmlns="http://www.w3.org/2000/svg">
                                    <path class="edo-logo-diamond" d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2"/>
                                    <rect x="9" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.2"/>
                                    <rect x="22" y="17" width="9" height="6" rx="3" fill="none" class="edo-logo-glasses" stroke-width="1.2"/>
                                    <line x1="18" y1="20" x2="22" y2="20" class="edo-logo-glasses" stroke-width="1.3"/>
                                    <line x1="7"  y1="20" x2="9"  y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                                    <line x1="31" y1="20" x2="33" y2="20" class="edo-logo-glasses" stroke-width="1.1"/>
                                </svg>
                            </div>
                            <div class="edo-message-bubble">
                                <div class="edo-message-sender">EDo</div>
                                <div class="edo-typing-indicator">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* Input Section *@
        @if (currentSessionId != 0)
        {
            <footer class="edo-chat-footer">
                <div class="edo-input-area-container">
                    
                    @* رسالة الأخطاء تظهر فوق بار الكتابة *@
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="edo-error-message">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="currentColor"/></svg>
                            <span>@errorMessage</span>
                        </div>
                    }

                    <div class="edo-input-box-row">
                        <textarea class="edo-textarea" 
                                  placeholder="اسألني عن أي شيء برمجيا..." 
                                  @bind="userInput"
                                  @bind:event="oninput"
                                  @onkeydown="HandleKeyDown"
                                  disabled="@isGenerating"
                                  rows="1"></textarea>

                        <button class="edo-send-btn" @onclick="SendMessage" disabled="@(isGenerating || string.IsNullOrWhiteSpace(userInput))">
                            <svg viewBox="0 0 24 24" width="18" height="18"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor"/></svg>
                        </button>
                    </div>
                    <div class="edo-input-footer">
                        <div class="edo-attach-btns"></div>
                        <div class="edo-hint"> نظام المحادثة المخصص للأكاديمية التعليمية</div>
                    </div>
                </div>
            </footer>
        }
    </main>

</div>

<style>
    /* CSS Variables & Themes */
    :root {
        --sidebar-width: 260px;
        --sidebar-collapsed-width: 68px;
        --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Light Theme */
    .edo-page.light-theme {
        --bg-page: #e8e8e8;
        --bg-sidebar: #f2f2f2;
        --bg-card: #ffffff;
        --bg-input: #d4d4d4;
        --bg-input-focus: #ffffff;
        --border-color: #cccccc;
        --text-color: #111111;
        --text-muted: #666666;
        --hover-bg: rgba(0,0,0,0.06);
        --active-bg: #d0e8ec;
        --accent-color: #4b7983;
        --user-msg-bg: #4b7983;
        --user-msg-text: #ffffff;
        --bot-msg-bg: #ffffff;
        --bot-msg-text: #111111;
        --bot-msg-border: #cccccc;
        --welcome-gradient-start: #111111;
        --welcome-gradient-end: #4b7983;
        --start-btn-shadow: rgba(75,121,131,0.3);
    }

    /* Dark Theme */
    .edo-page.dark-theme {
        --bg-page: #0f1923;
        --bg-sidebar: #0d1720;
        --bg-card: #172130;
        --bg-input: #1e2d3d;
        --bg-input-focus: #243547;
        --border-color: #1e3a4a;
        --text-color: #b0c8d0;
        --text-muted: #6a8a94;
        --hover-bg: rgba(141,201,212,0.07);
        --active-bg: #1e3a4a;
        --accent-color: #8dc9d4;
        --user-msg-bg: #1e3040;
        --user-msg-text: #ffffff;
        --bot-msg-bg: transparent;
        --bot-msg-text: #b0c8d0;
        --bot-msg-border: transparent;
        --welcome-gradient-start: #ffffff;
        --welcome-gradient-end: #8dc9d4;
        --start-btn-shadow: rgba(141,201,212,0.25);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    .edo-page {
        display: flex;
        width: 100%;
        height: 100vh;
        background-color: var(--bg-page);
        color: var(--text-color);
        font-family: var(--font-family);
        direction: rtl; /* اتجاه عربي متناسق */
        overflow: hidden;
    }

    /* Sidebar Styles*/
    .edo-sidebar {
        width: var(--sidebar-width);
        background-color: var(--bg-sidebar);
        border-left: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10;
        flex-shrink: 0;
    }

    .edo-sidebar.collapsed {
        width: var(--sidebar-collapsed-width);
    }

    .edo-sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        height: 64px;
        gap: 6px;
    }

    .edo-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        overflow: hidden;
        white-space: nowrap;
    }

    .edo-logo-mark {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .edo-logo-text {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: opacity 0.2s;
    }

    .edo-sidebar.collapsed .edo-logo-text {
        opacity: 0;
        pointer-events: none;
    }

    .edo-sidebar-toggle {
        background: none;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 6px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, color 0.2s;
    }

    .edo-sidebar-toggle:hover {
        background-color: var(--hover-bg);
        color: var(--text-color);
    }

    .edo-new-chat-btn {
        margin: 8px 12px 16px 12px;
        padding: 12px 16px;
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        color: var(--text-color);
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: background-color 0.2s, border-color 0.2s;
        overflow: hidden;
        white-space: nowrap;
    }

    .edo-new-chat-btn:hover:not(:disabled) {
        background-color: var(--hover-bg);
        border-color: #5f6368;
    }

    .edo-sidebar.collapsed .edo-new-chat-btn {
        padding: 12px;
        justify-content: center;
        border-radius: 50%;
    }

    .edo-sidebar.collapsed .edo-new-chat-btn span {
        display: none;
    }

    .edo-history-list {
        flex: 1;
        overflow-y: auto;
        padding: 0 8px;
    }

    .edo-history-list::-webkit-scrollbar { width: 4px; }
    .edo-history-list::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }

    .edo-history-group {
        margin-bottom: 20px;
    }

    .edo-history-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--text-muted);
        padding: 8px 12px;
        letter-spacing: 0.8px;
    }

    .edo-sidebar.collapsed .edo-history-label {
        display: none;
    }

    .edo-history-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13.5px;
        color: #c4c7c5;
        transition: background-color 0.15s;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
    }

    .edo-history-item:hover {
        background-color: var(--hover-bg);
    }

    .edo-history-item.active {
        background-color: var(--active-bg);
        color: var(--accent-color);
        font-weight: 500;
    }

    .edo-history-title {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .edo-sidebar.collapsed .edo-history-title {
        display: none;
    }

    .edo-history-item.empty, .edo-history-item.loading {
        color: var(--text-muted);
        font-size: 12px;
        font-style: italic;
        cursor: default;
    }
    .edo-sidebar.collapsed .edo-history-item.empty { display: none; }

    .edo-sidebar-footer {
        padding: 12px;
        border-top: 1px solid var(--border-color);
    }

    .edo-user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px;
    }

    .edo-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #4a90e2;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 15px;
        flex-shrink: 0;
    }

    .edo-user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        white-space: nowrap;
    }

    .edo-sidebar.collapsed .edo-user-info {
        display: none;
    }

    .edo-user-name {
        font-size: 13.5px;
        font-weight: 500;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .edo-user-status {
        font-size: 11px;
        color: #81c995;
    }

    /* Main Content & Messaging Area */
    .edo-main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }

    .edo-chat-header {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .edo-header-title h2 {
        font-size: 16px;
        font-weight: 500;
    }

    .edo-messages-container {
        flex: 1;
        overflow-y: auto;
        padding: 24px 15% 40px 15%;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .edo-messages-container::-webkit-scrollbar { width: 6px; }
    .edo-messages-container::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }

    .edo-message-wrapper {
        display: flex;
        gap: 18px;
        max-width: 100%;
        animation: fadeIn 0.3s ease;
    }

    .edo-message-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 600;
        flex-shrink: 0;
        margin-top: 4px;
    }

    .user-style {
        flex-direction: row-reverse;
    }
    .user-style .edo-message-avatar {
        background-color: #5c93db;
        color: white;
    }
    .user-style .edo-message-bubble {
        background-color: var(--user-msg-bg);
        color: var(--user-msg-text);
        border-radius: 18px 4px 18px 18px;
    }
    .user-style .edo-message-sender { text-align: left; }

    .bot-style .edo-message-avatar {
        background: linear-gradient(135deg, #4a90e2, #9b51e0);
    }
    .bot-style .edo-message-bubble {
        background-color: var(--bot-msg-bg);
        color: var(--bot-msg-text);
        border: 1px solid var(--bot-msg-border);
        border-radius: 4px 18px 18px 18px;
    }

    .edo-message-bubble {
        padding: 12px 18px;
        max-width: 75%;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .edo-message-sender {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
    }

    .edo-message-text {
        font-size: 15px;
        line-height: 1.6;
        word-break: break-word;
        white-space: pre-line;
    }

    .edo-message-time {
        font-size: 10px;
        color: var(--text-muted);
        align-self: flex-end;
        margin-top: 2px;
    }

    /* التنسيق الجديد لرسالة الخطأ */
    .edo-error-message {
        display: flex;
        align-items: center;
        gap: 8px;
        background-color: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #f87171;
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 12px;
        font-size: 13px;
        animation: fadeIn 0.2s ease-in-out;
    }

    /* Welcome Screen Style — see updated block below */

    .edo-start-chat-btn {
        background: linear-gradient(135deg, #4b7983, #3a6370);
        color: white;
        border: none;
        padding: 14px 28px;
        font-size: 15px;
        font-weight: 500;
        border-radius: 24px;
        cursor: pointer;
        box-shadow: 0 4px 12px var(--start-btn-shadow);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    /* لوجو EDo */
    .edo-logo-diamond {
        fill: #ffffff;
    }
    /* النظارة تكون داكنة دائماً لتظهر على المعين الأبيض */
    .edo-logo-glasses {
        stroke: #2a2a2a;
