        --bg-body:            #0f1923;
        --bg-card:            #172130;
        --bg-input:           #1e2d3d;
        --bg-input-focus:     #243547;
        --bg-overlay:         rgba(15,25,35,0.95);

        /* الألوان الرئيسية */
        --btn-main:           #1e3040;
        --btn-main-hover:     #6a8a94;
        --btn-text:           #ffffff;
        --accent:             #8dc9d4;

        /* النصوص */
        --text-color:         #b0c8d0;
        --text-muted:         #6a8a94;
        --text-on-dark:       #cccccc;

        /* الهيدر */
        --nav-bg:             #0d1720;
        --nav-border:         #1e3040;
        --nav-shadow:         rgba(0,0,0,0.6);

        /* الفوتر */
        --footer-bg:          linear-gradient(to right, #4c6d74 0%, #8dc9d4 100%);
        --footer-text:        #111111;
        --footer-link:        #1a1a1a;
        --footer-wave-fill:   #0f1923;
        --footer-divider:     rgba(255,255,255,0.45);
        --footer-icon:        #1a1a1a;
        --footer-icon-bg:     rgba(0,0,0,0.12);
        --footer-icon-hover:  darkorange;

        /* الحدود */
        --border-color:       #1e3a4a;
        --divider-color:      #1a3040;

        /* الحالات */
        --hover-bg:           rgba(123,45,62,0.08);
        --focus-ring:         rgba(123,45,62,0.4);

        /* النجوم */
        --star-empty:         #3a2a2e;
        --star-fill:          #ffb347;


        --transition-speed:   0.35s;
    }

    /* تطبيق المتغيرات على الصفحة الكاملة */
    .page {
        background-color: var(--bg-body);
        color: var(--text-color);
        min-height: 100vh;
        transition:
            background-color var(--transition-speed) ease,
            color            var(--transition-speed) ease;
    }

    /* عكس الألوان في الدارك مود */
    .dark-theme * {
        color: inherit;
        border-color: var(--border-color);
        transition:
            background-color var(--transition-speed) ease,
            color            var(--transition-speed) ease,
            border-color     var(--transition-speed) ease;
    }

    /* الخلفيات البيضاء */
    .dark-theme .bg-white,
    .dark-theme [style*="background-color: white"],
    .dark-theme [style*="background-color: #fff"],
    .dark-theme [style*="background-color: #ffffff"] {
        background-color: var(--bg-card) !important;
    }



    /* الكروت والـ containers */
    .dark-theme .card,
    .dark-theme .box,
    .dark-theme .panel,
    .dark-theme .container,
    .dark-theme .wrapper {
        background-color: var(--bg-card);
        border-color: var(--border-color);
    }

