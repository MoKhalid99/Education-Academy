    .dark-theme textarea,
    .dark-theme select {
        background-color: var(--bg-input) !important;
        color: var(--text-color) !important;
        border-color: var(--border-color) !important;
    }

    .dark-theme input:focus,
    .dark-theme textarea:focus,
