@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable
@inject HttpClient Http

<LoadingOverlay IsVisible="isPageLoading" />
<div class="page @(isDarkMode ? "dark-theme" : "")">
    @* نمرر حالة المود والحدث للـ Header *@
    <Header IsDarkMode="isDarkMode" OnToggleDarkMode="ToggleDarkMode" />
<div class="page-wrapper">
    

@Body

    
        <Footer IsDarkMode="isDarkMode" />
</div>
</div>
@*الشات بوت*@
<div class="AI-panel @(isChatOpen ? "open" : "") @(isDarkMode ? "dark-theme" : "")">
    <div class="AI-header">
        <div class="header-title">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="header-icon">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span>في انتظر عمو سيف</span>
        </div>
        <button class="close-btn" @onclick="ToggleChatbot">✕</button>
    </div>

    <div class="AI-body">
        <div class="chat-message bot">
            <div class="message-bubble">مرحباً بك! كيف يمكنني مساعدتك اليوم؟</div>
        </div>

        @foreach (var msg in chatMessages)
        {
            <div class="chat-message @(msg.IsUser ? "user" : "bot")">
                <div class="message-bubble">@msg.Text</div>
            </div>
        }

        @if (isTyping)
        {
            <div class="chat-message bot">
                <div class="message-bubble typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }
    </div>

    <div class="AI-footer">
        <div class="input-container">
            <textarea @bind="userInput" 
                      @onkeyup="HandleKeyUp"
                      placeholder="اسألني أي شيء يفيد تقدمك..." 
                      rows="1"></textarea>
            <button class="send-btn" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(userInput)">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M2 .057l22.5 11.943-22.5 11.943v-9.324l15-2.619-15-2.619z"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<button class="chatbot-float-btn @(isChatOpen ? "hidden" : "")" @onclick="ToggleChatbot" aria-label="Chatbot">
    <div class="stars-container">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="star-icon star-main">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="star-icon star-top-left">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="star-icon star-bottom-right">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
    </div>
</button>

@code
{
    private bool isChatOpen = false;
    private bool isTyping = false;
    private string userInput = string.Empty;
    private List<ChatMessage> chatMessages = new();

    private void ToggleChatbot()
    {
        isChatOpen = !isChatOpen;
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        // إرسال الرسالة عند الضغط على Enter بدون Shift
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var userMessage = userInput.Trim();
        userInput = string.Empty; // تفريغ صندوق الإدخال

        // إضافة رسالة المستخدم للقائمة
        chatMessages.Add(new ChatMessage { Text = userMessage, IsUser = true });
        isTyping = true;
        StateHasChanged();

        try
        {
            // API الخاص بالبوت
            var response = await Http.PostAsJsonAsync("api/chatbot/respond", new { Message = userMessage });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BotResponse>();
                chatMessages.Add(new ChatMessage { Text = result?.Response ?? "عذراً، لم أفهم ذلك.", IsUser = false });
            }
            else
            {
                chatMessages.Add(new ChatMessage { Text = "عذراً، حدث خطأ في الاتصال بالخادم.", IsUser = false });
            }
        }
        catch (Exception ex)
        {
            chatMessages.Add(new ChatMessage { Text = "فشل الاتصال بالـ API.", IsUser = false });
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isTyping = false;
            StateHasChanged();
        }
    }

    
    public class ChatMessage
    {
        public string Text { get; set; } = string.Empty;
        public bool IsUser { get; set; }
    }

    public class BotResponse
    {
        public string Response { get; set; } = string.Empty;
    }

    private bool isPageLoading = false;

    protected override void OnInitialized()
    {
        // الاشتراك في حدث تغيير الصفحة
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        //  إظهار شاشة التحميل عند بدء التنقل
        isPageLoading = true;
        StateHasChanged();

        // محاكاة وقت التحميل
        //يمكن تعديل الوقت
        await Task.Delay(3000);

        // إخفاء الشاشة بعد انتهاء التنقل
        isPageLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        // إلغاء الاشتراك عند إغلاق التطبيق لتجنب تسريب الذاكرة
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private bool isDarkMode = false;

    private void ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
    }
    
}
<style>
    /* Light Mode */
    :root {
        /* الخلفيات */
        --bg-body:            #ffffff;
        --bg-card:            #f5f5f5;
        --bg-input:           #d4d4d4;
        --bg-input-focus:     #ffffff;
        /* النصوص */
        --text-color:         #111111;
        --text-muted:         #444444;
        --text-on-dark:       #ffffff;

        --bg-overlay:         rgba(255,255,255,0.9);

        /* الألوان الرئيسية */
        --btn-main:           #4b7983;
        --btn-main-hover:     #3a6370;
        --btn-text:           #ffffff;
        --accent:             #8dc9d4;

