    }

    /* الأيقونات المخصصة في الدارك مود */

    /* أيقونات واضحة */
    .dark-theme .fa-volleyball-ball,
    .dark-theme .fa-volleyball,
    .dark-theme .fas.fa-volleyball-ball,
    .dark-theme i[class*="fa-volleyball"],
    .dark-theme .fa-star,
    .dark-theme .fas.fa-star,
    .dark-theme i[class*="fa-star"],
    .dark-theme .fa-lightbulb,
    .dark-theme .fas.fa-lightbulb,
    .dark-theme i[class*="fa-lightbulb"],
    .dark-theme .fa-code,
    .dark-theme .fas.fa-code,
    .dark-theme i[class*="fa-code"],
    .dark-theme .fa-plus-circle,
