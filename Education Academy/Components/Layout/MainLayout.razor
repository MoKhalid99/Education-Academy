@inherits LayoutComponentBase
@using ChatbotModule.Models
@using ChatbotModule.Services
@using ChatbotModule.AI
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using EducationAcademy.Data
@inject NavigationManager Navigation
@implements IDisposable
@inject IChatbotService ChatbotService
@inject AcademyDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject IJSRuntime JS

<LoadingOverlay IsVisible="isPageLoading" />
<CascadingValue Value="isDarkMode" Name="IsDarkMode">
    <div class="page @(isDarkMode ? "dark-theme" : "")">
        @* نمرر حالة المود والحدث للـ Header *@
        <Header IsDarkMode="isDarkMode" OnToggleDarkMode="ToggleDarkMode" />
        <div class="page-wrapper">
            @Body
            <Footer IsDarkMode="isDarkMode" />
        </div>
    </div>
</CascadingValue>

@*الشات بوت EDo المنبثق*@
<div class="AI-panel @(isChatOpen ? "open" : "") @(isDarkMode ? "dark-theme" : "")">
    <div class="AI-header">
        <div class="header-title">
            @* أيقونة EDo: معين أبيض + نظارة طبية *@
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="header-icon" width="24" height="24">
                <path d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2"
                      fill="currentColor" opacity="0.9" />
                <rect x="9" y="17" width="9" height="6" rx="3" fill="none" stroke="white" stroke-width="1" />
                <rect x="22" y="17" width="9" height="6" rx="3" fill="none" stroke="white" stroke-width="1" />
                <line x1="18" y1="20" x2="22" y2="20" stroke="white" stroke-width="1.2" />
                <line x1="7" y1="20" x2="9" y2="20" stroke="white" stroke-width="1" />
                <line x1="31" y1="20" x2="33" y2="20" stroke="white" stroke-width="1" />
            </svg>
            <span>EDo</span>
        </div>
        <button class="close-btn" @onclick="ToggleChatbot">✕</button>
    </div>

    <div class="AI-body" @ref="panelMessagesContainer">
        <div class="chat-message bot">
            <div class="message-bubble">مرحباً بك! أنا EDo، كيف يمكنني مساعدتك اليوم؟</div>
        </div>

        @if (messages != null)
        {
            @foreach (var msg in messages)
            {
                <div class="chat-message @(msg.Role == "user" ? "user" : "bot")">
                    <div class="message-bubble">@msg.Content</div>
                </div>
            }
        }

        @if (isGenerating)
        {
            <div class="chat-message bot">
                <div class="message-bubble typing-indicator">
                    <span></span><span></span><span></span>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(panelErrorMessage))
        {
            <div class="chat-message bot">
                <div class="message-bubble" style="color: #f87171; background-color: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3);">
                    @panelErrorMessage
                </div>
            </div>
        }
    </div>

    <div class="AI-footer">
        <div class="input-container">
            <textarea @bind="userInput"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="اسألني أي شيء يفيد تقدمك..."
                      disabled="@isGenerating"
                      rows="1"></textarea>
            <button class="send-btn" @onclick="SendMessage" disabled="@(isGenerating || string.IsNullOrWhiteSpace(userInput))">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M2 .057l22.5 11.943-22.5 11.943v-9.324l15-2.619-15-2.619z" />
                </svg>
            </button>
        </div>
        <div class="edo-panel-link-row">
            <a href="@aiPageUrl" class="edo-open-full-link">فتح EDo AI بالكامل ↗</a>
        </div>
    </div>
</div>

@* زر فتح الشات بوت العائم — معين أبيض + نظارة *@
<button class="chatbot-float-btn @(isChatOpen ? "hidden" : "")" @onclick="ToggleChatbot" aria-label="EDo AI Chatbot">
    <div class="edo-float-icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" class="edo-float-diamond" width="36" height="36">
            @* المعين الأبيض *@
            <path d="M20,2 C20,12 22,14 32,20 C22,26 20,28 20,38 C20,28 18,26 8,20 C18,14 20,12 20,2"
                  fill="#ffffff" />
            @* النظارة الطبية فوق المعين *@
            <rect x="9" y="17" width="9" height="6" rx="3" fill="none" stroke="#1a1a1a" stroke-width="1.1" />
            <rect x="22" y="17" width="9" height="6" rx="3" fill="none" stroke="#1a1a1a" stroke-width="1.1" />
            @* وصلت النظارة *@
            <line x1="18" y1="20" x2="22" y2="20" stroke="#1a1a1a" stroke-width="1.3" />
            @* ذراعا النظارة *@
            <line x1="7" y1="20" x2="9" y2="20" stroke="#1a1a1a" stroke-width="1.1" />
            <line x1="31" y1="20" x2="33" y2="20" stroke="#1a1a1a" stroke-width="1.1" />
        </svg>
    </div>
</button>

@code
{
    private bool isChatOpen = false;
    private bool isGenerating = false;
    private string userInput = string.Empty;
    private string aiPageUrl = "/AI";
    private string userId = string.Empty;
    private string panelErrorMessage = string.Empty;
    private int currentSessionId = 0;
    private List<ChatMessage> messages = new();
    private ElementReference panelMessagesContainer;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        aiPageUrl = Configuration["AISettings:PageUrl"] ?? "/AI";

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            await LoadLatestSession();
        }
    }

    private async Task LoadLatestSession()
    {
        try
        {
            var latestSession = await DbContext.ChatSessions
                .Where(s => s.UserID == userId)
                .OrderByDescending(s => s.CreatedAt)
                .FirstOrDefaultAsync();

            if (latestSession != null)
            {
                currentSessionId = latestSession.SessionID;
                var history = await ChatbotService.GetHistoryAsync(userId, currentSessionId);
                if (history != null)
                {
                    messages = history.ToList();
                }
            }
        }
        catch
        {
            // صامت أو إسناد رسالة خطأ خفيفة
        }
    }

    private void ToggleChatbot()
    {
        isChatOpen = !isChatOpen;
        if (isChatOpen)
        {
            _ = ScrollToBottom();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task CreateNewSession()
    {
        try
        {
            panelErrorMessage = string.Empty;
            string defaultTitle = $"محادثة سريعة {DateTime.Now:yyyy-MM-dd HH:mm}";
            var session = await ChatbotService.CreateSessionAsync(userId, defaultTitle);
            currentSessionId = session.SessionID;
        }
        catch (Exception)
        {
            panelErrorMessage = "فشل إنشاء محادثة جديدة.";
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isGenerating) return;

        if (string.IsNullOrEmpty(userId))
        {
            panelErrorMessage = "يرجى تسجيل الدخول أولاً للاستخدام.";
            return;
        }

        if (currentSessionId == 0)
        {
            await CreateNewSession();
        }

        var userMsgText = userInput.Trim();
        userInput = string.Empty;
        isGenerating = true;
        panelErrorMessage = string.Empty;

        var userMsg = new ChatMessage
        {
            SessionID = currentSessionId,
            Role = AiRoles.User,
            Content = userMsgText,
            CreatedAt = DateTime.UtcNow
        };
        messages.Add(userMsg);
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var request = new ChatRequest { SessionId = currentSessionId, Message = userMsgText };
            var response = await ChatbotService.SendMessageAsync(userId, request);

            if (response != null && string.IsNullOrEmpty(response.Error))
            {
                messages.Add(new ChatMessage
                {
                    SessionID = currentSessionId,
                    Role = AiRoles.Assistant,
                    Content = response.Reply,
                    CreatedAt = response.CreatedAt
                });
            }
            else
            {
                panelErrorMessage = response?.Error ?? "لم نتمكن من تلقي إجابة من الذكاء الاصطناعي.";
            }
        }
        catch (Exception)
        {
            panelErrorMessage = "حدثت مشكلة أثناء معالجة الرد.";
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "setTimeout(() => { const el = document.querySelector('.AI-body'); if(el) el.scrollTop = el.scrollHeight; }, 50);");
        }
        catch { }
    }

    private bool isPageLoading = false;

    private async void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isPageLoading = true;
        StateHasChanged();

        await Task.Delay(3000);
        isPageLoading = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private bool isDarkMode = false;

    private void ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
    }
}

