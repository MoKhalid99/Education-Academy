        color: var(--text-color) !important;
        border-top-color: var(--border-color) !important;
    }

    .dark-theme .anchor_container.level-locked .courses_buttons {
        background: var(--bg-input) !important;
        opacity: 0.55 !important;
    }
    /* الهيدر - حركة أزرار */
    .dark-theme .low_section_buttons {
        transition: color 0.2s ease !important;
    }

    .dark-theme .low_section_buttons:hover,
    .dark-theme .low_section_buttons:hover .low_section_buttons_text {
        color: orange !important;
    }

    .dark-theme .low_section_buttons_special,
